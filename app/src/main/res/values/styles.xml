<resources>
    <!-- Tema do app: sem barra de título e em tela cheia (seção 6.4.2 do livro).
         "DayNight" faz o app trocar entre claro e escuro conforme o modo escolhido. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Tema do diálogo de fim de jogo: janela transparente, o "cartão" é desenhado pelo layout -->
    <style name="GameDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">0dp</item>
    </style>
</resources>
